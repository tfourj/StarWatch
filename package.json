{
  "name": "starwatch",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:web",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build src/server/index.ts --target bun --outdir dist/server --minify",
    "build:demo": "vite build --mode demo",
    "dev:demo": "vite --mode demo",
    "start": "bun dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "screenshots": "sh scripts/screenshots.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
