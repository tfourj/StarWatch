# Port the app listens on inside the container
PORT=4321
# Public URL (used for auth callbacks and webhook URLs)
BASE_URL=https://starwatch.example.com
# Leave empty to auto-generate into /data on first run
BETTER_AUTH_SECRET=
ENCRYPTION_SECRET=
# Allow extra users to sign up after the first admin
ALLOW_REGISTRATION=false
# Default timezone, each user can change it in Settings -> Account
TZ=UTC
# Optional GitHub OAuth login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
